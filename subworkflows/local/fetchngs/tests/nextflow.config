/*
    Test-scoped resource cap for the FETCHNGS nf-test.

    conf/base.config (not owned by this task, left untouched) sets
    withLabel:process_low to request 12.GB, which exceeds memory available in
    small/CI sandboxes. Cap actual requests via resourceLimits so the
    FTP-download modules (SRA_IDS_TO_RUNINFO, SRA_FASTQ_FTP, etc., all light
    wget/python steps) fit in a constrained test environment without touching
    the shared base.config.
*/
process {
    resourceLimits = [
        cpus: 2,
        memory: '3.GB',
        time: '1.h'
    ]
}
