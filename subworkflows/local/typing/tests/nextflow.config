/*
 * nf-test config for the TYPING (MLST + spa + SCCmec) subworkflow test.
 *
 * Same resourceLimits pattern as subworkflows/local/funcscan_arg/tests -
 * this dev sandbox has ~6.7 GB total RAM, under the 12-36 GB that
 * process_low/process_medium request by default (see conf/base.config).
 */
process {
    resourceLimits = [
        cpus: 2,
        memory: '4.GB',
        time: '2.h'
    ]
}
