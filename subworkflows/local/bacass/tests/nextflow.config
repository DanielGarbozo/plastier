/*
 * nf-test config for the BACASS subworkflow test.
 *
 * This dev sandbox only has ~6.7 GB of total RAM, well under the 12-36 GB that
 * nf-core's process_low/process_medium labels request by default (see
 * conf/base.config). resourceLimits caps every process's computed cpus/memory/time
 * to this ceiling rather than erroring out - the same mechanism nf-core/bacass's
 * own conf/test.config uses (cpus: 4, memory: 15.GB, time: 1.h), just scaled down
 * to fit what's actually available here.
 */
process {
    resourceLimits = [
        cpus: 4,
        memory: '5.GB',
        time: '2.h'
    ]
}
