/*
 * nf-test config for the PLASMID_CLASSIFICATION (stage 4) subworkflow test.
 *
 * Same resourceLimits pattern as subworkflows/local/typing/tests and
 * subworkflows/local/funcscan_arg/tests - this dev sandbox has ~6.7 GB total
 * RAM, under the 12-36 GB that process_medium requests by default (see
 * conf/base.config).
 */
process {
    resourceLimits = [
        cpus: 2,
        memory: '4.GB',
        time: '4.h'
    ]
}
