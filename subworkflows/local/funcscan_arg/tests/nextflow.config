/*
 * nf-test config for the ARG (funcscan ARG screening) subworkflow test.
 *
 * This dev sandbox only has ~6.7 GB of total RAM, well under the 12-36 GB that
 * nf-core's process_low/process_medium labels request by default (see
 * conf/base.config). resourceLimits caps every process's computed cpus/memory/time
 * to this ceiling rather than erroring out - same mechanism used by
 * subworkflows/local/bacass/tests/nextflow.config, scaled down further since this
 * subworkflow's test only exercises AMRFinderPlus + ABRicate + fARGene (RGI and
 * DeepARG are skipped - they need a CARD database build / large ML model download
 * respectively, both too heavy for this sandbox).
 */
process {
    resourceLimits = [
        cpus: 2,
        memory: '4.GB',
        time: '2.h'
    ]

    /*
     * NOTE: upstream nf-core/funcscan 4.0.0's own conf/modules.config sets
     * `ext.prefix = { "${report}.amrfinderplus" }` on HAMRONIZATION_AMRFINDERPLUS
     * specifically to avoid a filename collision: AMRFINDERPLUS_RUN emits
     * "${meta.id}.tsv" and, with the default prefix (meta.id) and format ('tsv'),
     * HAMRONIZATION_AMRFINDERPLUS would try to write an output file with that exact
     * same name into the same task work dir as its own (symlinked) input file. This
     * repo's root nextflow.config additionally runs process scripts under `bash -C`
     * (noclobber), which turns that same-name collision into a hard error instead of
     * a silent overwrite. This repo has no conf/modules.config entry yet for these
     * ARG processes (that file is out of scope for this vendoring task - it belongs
     * to the coordinator), so the same override is applied here, test-locally,
     * verbatim from upstream, to unblock the test. Whoever wires this subworkflow
     * into the real pipeline's conf/modules.config should carry the same override
     * (and check the other HAMRONIZATION_* modules for the same class of problem)
     * for production runs.
     */
    withName: 'HAMRONIZATION_AMRFINDERPLUS' {
        ext.prefix = { "${report}.amrfinderplus" }
    }
}
