/*
 * nf-test config for the EVIDENCE_INTEGRATION (stage 5) subworkflow test.
 *
 * Same resourceLimits pattern as the other local subworkflow tests in this
 * repo - this dev sandbox has ~6.7 GB total RAM.
 */
process {
    resourceLimits = [
        cpus: 2,
        memory: '4.GB',
        time: '1.h'
    ]
}
