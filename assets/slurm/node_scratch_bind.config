/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Optional extra config for Slurm clusters with per-job node-local scratch
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Some clusters give each job its own scratch dir under /state/<partition>/job-<id>
    and point $TMPDIR at it. Apptainer only auto-mounts home/cwd/workDir, so a tool
    writing to $TMPDIR inside the container can fail with "Error creating a temporary
    directory". Pass this file with `-c` to bind the parent path. Edit the path for
    your cluster.

        nextflow run . -profile test,singularity,slurm -c assets/slurm/node_scratch_bind.config
----------------------------------------------------------------------------------------
*/

apptainer.runOptions   = '--bind /state/partition1'
singularity.runOptions = '--bind /state/partition1'
