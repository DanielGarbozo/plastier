/*
    Extra config for assets/validation/run_sensitivity.sbatch (pass with -c).

    A simulated read set that cannot be assembled (SPAdes rejects error-poor or error-rich
    simulated data with "invalid kmer coverage histogram") is a finding of the sensitivity
    analysis, not a reason to abort the run. Ignore the failed Unicycler task so the other
    samples finish; bin/sensitivity_summary.py counts a sample with no output as every gene
    lost. Do NOT use this for a real-data run, where a failed assembly should stop the run.
*/

process {
    withName: 'UNICYCLER' {
        errorStrategy = 'ignore'
    }
}
