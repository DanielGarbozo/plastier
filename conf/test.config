/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run plastier/plastier -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '4.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal S. aureus test: bacass short-read/unicycler assembly on nf-core test-datasets'

    // Input data: bacass's own CI samplesheet - 2 small public S. aureus paired-end
    // runs (ERR044595, ERR064912), pre-subsampled to 1M reads/pair so the smoke test
    // stays fast. Goes straight into stage 2 (nf-core/bacass) via --input.
    //
    // Stage 1 (nf-core/fetchngs, --sra_ids) is deliberately NOT exercised here: full
    // (non-subsampled) ENA downloads + assembly would take well over an hour and
    // break the "tiny subset, near-zero cost" test profile guardrail in CLAUDE.md.
    // Fetchngs's own download/samplesheet-building logic is instead covered directly
    // by subworkflows/local/fetchngs/tests/main.nf.test (real ENA FTP download,
    // same two accessions, verified separately).
    input = "${projectDir}/assets/test/samplesheet_saureus.csv"

    // bacass tuning: short-read only, skip slow/optional steps not needed to
    // prove the wiring works end to end
    assembly_type   = 'short'
    assembler       = 'unicycler'
    prokka_args     = ' --fast'
    skip_kraken2    = true
    skip_kmerfinder = true
    skip_pycoqc     = true
}
