/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SPATYPER' {
        publishDir = [
            path: { "${params.outdir}/spatyper" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'STAPHOPIASCCMEC' {
        publishDir = [
            path: { "${params.outdir}/staphopiasccmec" },
            mode: params.publish_dir_mode
        ]
    }

    // Stage 4/6: these modules write fixed filenames under results/ (contig_report.txt,
    // prediction.csv, sccmec_unified_report.tsv), so with more than one sample every
    // sample published to the same path and only the last one survived. Publish into a
    // per-sample folder instead, dropping the redundant results/ level.
    withName: 'MOBSUITE_RECON|RFPLASMID|SCCMECEXTRACTOR' {
        publishDir = [
            path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.replaceFirst('^results/', '') }
        ]
    }

    // Stage 3 (ARG screening): each hamronization/* wrapper defaults ext.prefix to
    // just ${meta.id}, so per-sample TSVs from different ARG tools all collide on the
    // same filename once collected for HAMRONIZATION_SUMMARIZE ("input file name
    // collision" - Nextflow can't stage two same-named files into one task). Giving
    // each tool its own prefix keeps filenames unique before that collect().
    withName: 'HAMRONIZATION_ABRICATE' {
        ext.prefix = { "${meta.id}_abricate" }
    }
    withName: 'HAMRONIZATION_AMRFINDERPLUS' {
        ext.prefix = { "${meta.id}_amrfinderplus" }
    }
    withName: 'HAMRONIZATION_FARGENE' {
        ext.prefix = { "${meta.id}_fargene" }
    }
    withName: 'HAMRONIZATION_RGI' {
        ext.prefix = { "${meta.id}_rgi" }
    }
    withName: 'HAMRONIZATION_DEEPARG' {
        ext.prefix = { "${meta.id}_deeparg" }
    }
}
