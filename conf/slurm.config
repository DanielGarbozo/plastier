/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running on NYU HPC (Greene) via Slurm
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Each process is submitted as its own Slurm job (via Nextflow's slurm executor),
    using the cpus/memory/time already defined per process label in conf/base.config.
    This means individual tasks stay short even if the whole pipeline run spans many
    hours - only the lightweight Nextflow head process needs to survive that long
    (see notes below on -resume for surviving walltime limits on the head job itself).

    Use as follows:
        nextflow run plastier/plastier -profile <test/pilot/...>,slurm,singularity --outdir <OUTDIR>

    The head Nextflow process itself should be submitted via sbatch (see the example
    sbatch script referenced in docs), requesting only modest cpus/memory (it just
    orchestrates and polls - it does not run the actual tools). If that head job's
    walltime runs out before the pipeline finishes, completed per-task work is safely
    cached in `-work-dir`; resubmit the *same* sbatch script (same -work-dir, same
    params) with `-resume` and Nextflow will skip everything already done.
----------------------------------------------------------------------------------------
*/

params {
    // Override with --slurm_partition <name> for a different partition/QOS.
    // 'cpu_short' matches this session's own current job partition; switch to
    // cpu_prem/cs/etc. as appropriate for longer-running per-task work (process_high
    // in conf/base.config requests up to 16h per task, which will not fit a partition
    // with a hard short-job time cap - check `sinfo`/`sacctmgr show qos` for actual
    // limits on your account before a big run).
    slurm_partition = 'cpu_short'

    // NYU Torch HPC requires an explicit project account on every job (the old
    // implicit 'users' account no longer works - see `sacctmgr show associations
    // user=$USER format=account%30`). Override with --slurm_account <name> for a
    // different project.
    slurm_account   = 'torch_pr_127_general'
}

process {
    executor       = 'slurm'
    queue          = params.slurm_partition
    clusterOptions = "--account=${params.slurm_account}"
}

// Each Slurm job on this cluster gets its own node-local scratch dir at
// /state/partition1/job-<jobid> (NXF/Apptainer inherit $TMPDIR pointing there),
// but Apptainer only auto-mounts home/cwd/workDir - not that path - so any tool
// that writes to $TMPDIR inside the container fails with "Error creating a
// temporary directory". Bind it explicitly.
apptainer.runOptions   = '--bind /state/partition1'
singularity.runOptions = '--bind /state/partition1'

executor {
    // Cap how many Slurm jobs Nextflow keeps in flight at once and how fast it
    // submits them, to stay a good citizen on a shared scheduler.
    queueSize       = 20
    submitRateLimit = '10/1min'
}
