/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running on an HPC cluster via Slurm
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Each process is submitted as its own Slurm job (via Nextflow's slurm executor),
    using the cpus/memory/time already defined per process label in conf/base.config.
    This means individual tasks stay short even if the whole pipeline run spans many
    hours - only the lightweight Nextflow head process needs to survive that long
    (see notes below on -resume for surviving walltime limits on the head job itself).

    Use as follows:
        nextflow run plastier/plastier -profile <test/pilot/...>,slurm,singularity \
            --slurm_account <your_project_account> --outdir <OUTDIR>

    The head Nextflow process itself should be submitted via sbatch, requesting only
    modest cpus/memory (it just orchestrates and polls - it does not run the actual
    tools). If that head job's walltime runs out before the pipeline finishes,
    completed per-task work is safely cached in `-work-dir`; resubmit the *same*
    sbatch script (same -work-dir, same params) with `-resume` and Nextflow will skip
    everything already done.
----------------------------------------------------------------------------------------
*/

params {
    // Slurm partition/QOS to submit each task to. Override with --slurm_partition.
    slurm_partition = 'cpu_short'

    // Some Slurm clusters require an explicit project/billing account on every job
    // submission (check `sacctmgr show associations user=$USER` if unsure). No
    // default is set here on purpose - pass --slurm_account <name> explicitly.
    slurm_account   = null

    // Longest walltime any single task may request, e.g. '6.h'. Some partitions/QOS
    // reject a job outright (not just queue it) when it asks for more than their limit,
    // and conf/base.config requests up to 8 h (process_medium) or 16 h (process_high).
    // Set this to your partition's limit; requests above it are clamped down to it.
    // Default null = no clamp.
    slurm_max_time  = null
}

process {
    executor       = 'slurm'
    queue          = params.slurm_partition
    clusterOptions = params.slurm_account ? "--account=${params.slurm_account}" : null
    resourceLimits = params.slurm_max_time ? [ time: params.slurm_max_time ] : [:]
}

// Some clusters give each Slurm job its own node-local scratch dir (e.g. under
// /state/<partition>/job-<jobid>) and point $TMPDIR at it, but Apptainer only
// auto-mounts home/cwd/workDir by default - not arbitrary node-local paths - so a
// tool writing to $TMPDIR inside the container can fail with "Error creating a
// temporary directory". If you hit that, bind-mount the parent of your cluster's
// per-job scratch path here, e.g.:
//   apptainer.runOptions   = '--bind /state/partition1'
//   singularity.runOptions = '--bind /state/partition1'

executor {
    // Cap how many Slurm jobs Nextflow keeps in flight at once and how fast it
    // submits them, to stay a good citizen on a shared scheduler.
    queueSize       = 20
    submitRateLimit = '10/1min'
}
