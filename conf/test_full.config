/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-feature tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Unlike conf/test.config (which skips every slow/optional tool to keep the smoke
    test fast), this profile exercises the full pipeline - every ARG tool, both
    optional plasmid classifiers, and contamination screening - on the same tiny,
    nf-core-hosted S. aureus dataset. It stays within the "near-zero cost, runs
    anywhere" CI scope in docs/roadmap.md: no AWS execution, no per-genome budget,
    just public database downloads (CARD, DeepARG model, Platon, RFPlasmid) done in
    CI. This is NOT the Phase 0 pilot (conf/pilot.config, Nkiruka-only, $8 AWS cap)
    and NOT the Phase 3 full discovery run (conf/full.config, not approved) - do not
    point this profile at real research data or a paid executor.

    Use as follows:
        nextflow run plastier/plastier -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '8.GB',
        time: '4.h'
    ]
}

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Exercises every optional tool (ARG, plasmid classification, contamination screening) on the same small S. aureus test dataset as -profile test'

    // Same public, pre-subsampled S. aureus pairs as -profile test (see conf/test.config) -
    // no larger/real dataset is in scope for CI (docs/roadmap.md, Phase 0 is
    // pilot-only and Nkiruka-executed).
    input = "${projectDir}/assets/test/samplesheet_saureus.csv"

    assembly_type = 'short'
    assembler     = 'unicycler'

    // Unlike -profile test: run full annotation and every contamination-screening
    // step instead of skipping them for speed.
    skip_kraken2    = false
    skip_kmerfinder = false
    skip_pycoqc     = false

    // ARG (stage 3): run every tool test.config skips, so CI proves the full
    // 5-tool -> hAMRonization -> argnorm wiring, not just the fast subset.
    arg_skip_rgi         = false
    arg_skip_deeparg     = false
    arg_skip_argnorm     = false
    // Full HMM model set (test.config restricts this to one class for speed).
    arg_fargene_hmmmodel = 'class_a,class_b,class_c,class_d,qnr,tet_efflux,tet_rpg,tet_enzyme'

    // Plasmid classification (stage 4): run both optional classifiers that
    // test.config skips, so MOB-suite + Platon + RFPlasmid agreement (stage 5a,
    // #24) is exercised with real 3-way data instead of MOB-suite alone.
    plasmid_skip_platon    = false
    plasmid_skip_rfplasmid = false
}
