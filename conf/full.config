/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for a full discovery run
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    STUB — not runnable, and not approved. See docs/roadmap.md ("Phase 3 — Scale-up").

    This profile is for a future, larger-than-pilot discovery run. It has no
    approved genome count, budget, or timeline yet. Do NOT default to this
    profile, do not run it, and do not treat the Phase 0 $8 cap as extending to
    it — a full run needs its own explicit budget decision from Daniel,
    coordinated with Nkiruka for any AWS execution.

    Use as follows (once approved):
        nextflow run plastier/plastier -profile full,docker --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full discovery run'
    config_profile_description = 'Not approved - see docs/roadmap.md (Phase 3)'

    // TODO(Phase 3, pre-approval): no input is set. This profile must not be
    // runnable until scope and budget are approved.
    sra_ids = null
}
