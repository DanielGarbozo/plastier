/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the Phase 3 scale-up (discovery) run
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    See docs/roadmap.md ("Phase 3 - Scale-up"): about 20 public S. aureus short-read
    runs, executed on a Slurm cluster (combine with `-profile slurm,singularity`).
    AWS execution stays restricted to Nkiruka on the paid codespace - this profile does
    not change that.

    Runs the whole pipeline (stages 1-6) with all three plasmid classifiers. Unlike
    conf/test.config it does not subsample or shorten anything.

    `sra_ids` stays unset here even though the candidate list is now reviewed (see
    docs/phase3_candidates.md, docs/phase3_results.md - the 2026-09-27 Phase 3 run
    reviewed all 20 samples' ST/spa/SCCmec/ARG calls; SRR6347285 has no MLST ST but was
    kept, see phase3_results.md). Setting a default here does not actually work: `--input`
    on the CLI cannot unset a config-level `sra_ids` default (there is no way to pass "no
    value" for a string param - Nextflow's CLI parser treats `--sra_ids ''` as the boolean
    `true`, not an empty/absent value - checked empirically), and `--sra_ids` takes
    precedence over `--input` in workflows/plastier.nf, which would silently break
    assets/phase3/run_phase3.sbatch's default (DNS-safe) `--input` path by sending it into
    the fetchngs branch instead. Pass the reviewed list explicitly instead (the sbatch
    script does, and always has):
        nextflow run . -profile full,singularity,slurm \
            --sra_ids assets/phase3/sra_ids_candidates.txt \
            --slurm_account <account> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Phase 3 scale-up'
    config_profile_description = '~20 public S. aureus short-read genomes, stages 1-6, Slurm'

    // See the file header: kept null on purpose, not a leftover TODO.
    sra_ids = null

    // Short reads only (all Phase 3 candidates are Illumina paired-end).
    assembly_type = 'short'
    assembler     = 'unicycler'

    // Contamination screening needs a Kraken2 / KmerFinder database that is not set
    // up yet, same as conf/test.config. Species is checked instead by stage 6's MLST:
    // a non-S. aureus sample returns no sequence type (docs/phase3_candidates.md).
    skip_kraken2    = true
    skip_kmerfinder = true
    skip_pycoqc     = true

    // Same ARG-tool restrictions as conf/test.config and conf/validation.config (RGI
    // and DeepARG databases not set up, argnorm 0.8.0 schema incompatibility).
    arg_skip_rgi     = true
    arg_skip_deeparg = true
    arg_skip_argnorm = true
}

process {
    // conf/base.config's process_high (12 cpus / 72 GB) is far more than Unicycler needs
    // on one ~3 Mb short-read genome, and on a per-user-capped QOS it would run the
    // assemblies one at a time. Retries still scale the request up.
    withName: 'UNICYCLER' {
        cpus   = 8
        memory = { 24.GB * task.attempt }
    }
}
