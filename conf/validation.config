/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the stage 7 closed-genome validation run
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Runs stages 3-6 on the closed reference genomes in
    assets/validation/closed_genome_ground_truth.csv via --assemblies (stages 1-2 are
    skipped: a re-assembly would lose the replicon accessions the benchmark scores
    against, see bin/evaluate_metrics.py). Unlike the `test` profile, all three plasmid
    classifiers run - the tier framework being validated depends on their agreement.

    Use as follows (assets/validation/run_stage7.sbatch does all of this):
        python3 assets/validation/fetch_reference_genomes.py --outdir <DIR> --samplesheet <DIR>/assemblies.csv
        nextflow run . -profile validation,singularity,slurm --assemblies <DIR>/assemblies.csv \
            --slurm_account <account> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Stage 7 validation profile'
    config_profile_description = 'Stages 3-6 on closed S. aureus reference genomes, all plasmid classifiers enabled'

    // Same ARG-tool restrictions as conf/test.config, for the same reasons: RGI needs
    // the CARD database built, DeepARG needs a large model download, and argnorm 0.8.0
    // is incompatible with hAMRonization's normalised schema (see
    // subworkflows/local/funcscan_arg/tests/main.nf.test). ABRicate, AMRFinderPlus and
    // fARGene still run.
    arg_skip_rgi     = true
    arg_skip_deeparg = true
    arg_skip_argnorm = true

    // Platon (~2.8 GB) and RFPlasmid (~645 MB) databases are downloaded on first use
    // and cached in the work dir; plasmid_skip_platon / plasmid_skip_rfplasmid stay at
    // their default (false) so both run.
}
