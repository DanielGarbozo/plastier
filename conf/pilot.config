/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the Phase 0 pilot run
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    STUB — not runnable yet. See docs/roadmap.md ("Phase 0 — Pilot") and CLAUDE.md
    ("Status and budget guardrails") for the approved scope.

    Phase 0 is 10 S. aureus genomes, capped at $8 USD AWS spend, and may ONLY be
    executed by Nkiruka on the paid AWS codespace. Do not point this profile at an
    AWS Batch / cloud executor, and do not run it, without her direct involvement
    and Daniel's confirmation.

    Use as follows (Nkiruka only, on the paid codespace):
        nextflow run plastier/plastier -profile pilot,docker --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Phase 0 pilot'
    config_profile_description = '10-genome S. aureus pilot, $8 USD budget cap - Nkiruka execution only'

    // TODO(Phase 0, pre-execution): point sra_ids at the 10-genome pilot accession
    // list once it is finalised and reviewed. Intentionally left unset so this
    // profile fails closed rather than silently running against no/wrong data.
    sra_ids = null

    assembly_type   = 'short'
    assembler       = 'unicycler'
}

// TODO(Phase 0, pre-execution): set resource/executor limits appropriate to the
// $8 cap once Nkiruka has confirmed the target AWS instance profile. Left
// unset deliberately - do not guess at cloud executor config here.
